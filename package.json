{
  "name": "issuedesk",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node .neander/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "check": "tsc --noEmit",
    "check:issue-filters": "node --experimental-strip-types --env-file=.env.local scripts/check-issue-filters.mjs",
    "db:dev": "node scripts/db-dev.mjs",
    "smoke:auth": "node --env-file=.env.local scripts/smoke-auth.mjs",
    "smoke:api": "node --env-file=.env.local scripts/smoke-api.mjs",
    "test": "python3 scripts/test_deployment_contract.py && tsx scripts/test-markdown-security.tsx",
    "db:migrate": "node .neander/migrate.mjs",
    "db:seed": "node .neander/seed.mjs",
    "test:template": "node scripts/verify-template.mjs",
    "test:policy": "python3 scripts/check_repository.py",
    "verify": "pnpm run check && pnpm run test && pnpm run test:policy && pnpm run build",
    "test:production": "node scripts/verify-template.mjs",
    "test:features": "node --env-file=.env.local scripts/test-feature-workflows.mjs",
    "test:feature-ui": "node --env-file=.env.local scripts/test-feature-experience.mjs",
    "test:github-runtime": "node --env-file=.env.local scripts/test-github-runtime.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.21",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "5.3.0",
    "@next/env": "16.4.6",
    "@octokit/auth-app": "8.3.1",
    "@octokit/request": "10.0.16",
    "@octokit/webhooks-methods": "6.0.0",
    "better-auth": "1.7.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.23.0",
    "next": "16.4.6",
    "pg": "8.23.0",
    "radix-ui": "1.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "auth": "1.7.21",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "16.15.0-beta.19",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
